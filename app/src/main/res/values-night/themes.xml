<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AgroMarket" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/status_bar_dark</item>
        <item name="android:navigationBarColor">@color/nav_bar_dark</item>
    </style>

    <style name="Theme.AgroMarket.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.AgroMarket</item>
    </style>
</resources>
